PORT=3000
HOST=127.0.0.1
# Set a strong operator key before exposing the server beyond localhost.
OPERATOR_KEY=
PUBLIC_ORIGIN=http://localhost:3000
NVR_HOST=
NVR_USER=
NVR_PASSWORD=
# Optional override; omit to use the installed ffmpeg-static binary.
# FFMPEG_PATH=C:/tools/ffmpeg/bin/ffmpeg.exe
# Required: salt:hex-scrypt-hash for portal authentication (never put password in source).
ACCESS_PASSWORD_HASH=
COOKIE_SECURE=false
NVR_PORT=554
NVR_SUBTYPE=0
